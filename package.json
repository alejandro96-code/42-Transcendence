{
  "name": "transcendence",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run dev:frontend",
    "dev:frontend": "vite frontend --config frontend/vite.config.ts",
    "dev:backend": "nodemon backend/src/index.js",
    "build": "tsc -p frontend/tsconfig.app.json && vite build frontend --config frontend/vite.config.ts",
    "lint": "eslint frontend backend",
    "start": "node backend/src/index.js",
    "preview": "vite preview frontend --config frontend/vite.config.ts"
  },
  "dependencies": {
    "@2toad/profanity": "^3.3.0",
    "@reduxjs/toolkit": "^2.11.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-json-validator-middleware": "^3.0.0",
    "express-session": "^1.17.3",
    "i18next": "^26.3.6",
    "passport": "^0.7.0",
    "passport-42": "^1.2.6",
    "pg": "^8.11.3",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primereact": "^10.9.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.11",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "nodemon": "^3.0.1",
    "sass": "^1.97.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.3.1"
  }
}
